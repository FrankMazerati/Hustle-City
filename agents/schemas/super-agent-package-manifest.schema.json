{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hustle-city.local/schemas/super-agent-package-manifest.schema.json",
  "title": "Hustle City Super Agent Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "batch_id", "title", "version", "status", "memory_sections", "scope", "acceptance_criteria", "deliverables", "handoff"],
  "properties": {
    "package_id": {"type":"string","pattern":"^HC-[A-Z0-9-]+$"},
    "batch_id": {"type":"string","pattern":"^HC-B[0-9]{2}$"},
    "title": {"type":"string","minLength":1},
    "version": {"type":"integer","minimum":1},
    "status": {"enum":["queued","in_progress","partial","submitted","in_review","correction_required","accepted","blocked","superseded"]},
    "owner": {"const":"super-agent"},
    "memory_sections": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["MASTER_PROJECT","SCRIBE_AND_LENS","WORLD","PEOPLE","TRANSPORTATION","SYSTEMS","QUALITY","ASSET_LIBRARY","SOCIAL_AND_LIFESTYLE"]}},
    "scope": {"type":"object","required":["in_scope","out_of_scope"],"properties":{"in_scope":{"type":"array","items":{"type":"string"}},"out_of_scope":{"type":"array","items":{"type":"string"}}}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "source_refs": {"type":"array","items":{"type":"string"}},
    "creator_decisions": {"type":"array","items":{"type":"string"}},
    "assumptions": {"type":"array","items":{"type":"string"}},
    "acceptance_criteria": {"type":"array","minItems":1,"items":{"type":"string"}},
    "deliverables": {"type":"array","items":{"type":"object","required":["path","status"],"properties":{"path":{"type":"string"},"status":{"enum":["planned","created","updated","partial","not_created"]},"description":{"type":"string"}}}},
    "verification": {"type":"object","properties":{"commands_run":{"type":"array","items":{"type":"string"}},"results":{"type":"array","items":{"type":"string"}},"not_run":{"type":"array","items":{"type":"string"}},"evidence_paths":{"type":"array","items":{"type":"string"}}}},
    "handoff": {"type":"object","required":["immutable_checkpoint","submitted_at","qa_requested"],"properties":{"immutable_checkpoint":{"type":"boolean"},"submitted_at":{"type":"string"},"qa_requested":{"type":"boolean"},"qa_focus":{"type":"array","items":{"type":"string"}}}},
    "memory_writeback": {"type":"array","items":{"type":"string"}},
    "open_items": {"type":"array","items":{"type":"string"}},
    "change_history": {"type":"array","items":{"type":"string"}}
  }
}