{
  "schema_version": "1.0.0",
  "project": "Hustle City",
  "runtime": "ollama_local",
  "activation_mode": "manual_single_task",
  "concurrency": {
    "max_active_workers": 1,
    "serialize_requests": true,
    "unload_model_after_task": true
  },
  "endpoint": {
    "base_url": "http://127.0.0.1:11434",
    "generate_path": "/api/generate",
    "timeout_seconds": 900
  },
  "note": "Initial assignments are capability-based defaults, not benchmark results. Every worker is invoked on demand; no background scheduler or always-on agents are activated.",
  "model_pool": [
    {
      "model": "deepseek-r1:1.5b",
      "profile": "reasoning_and_planning"
    },
    {
      "model": "gemma3:1b",
      "profile": "lightweight_summaries_and_triage"
    },
    {
      "model": "qwen3:1.7b",
      "profile": "general_instruction_and_analysis"
    },
    {
      "model": "llama3.2:3b",
      "profile": "creative_direction_and_general_writing"
    },
    {
      "model": "gemma2:2b",
      "profile": "independent_review_and_critique"
    },
    {
