{
  "schema_version": "1.0.0",
  "project": "Hustle City",
  "operating_mode": "single_super_agent_with_external_project_lead_qa",
  "activation_status": "disabled_pending_host_and_runtime_verification",
  "production_worker": {
    "agent_id": "super-agent",
    "display_name": "Hustle City Super Agent",
    "identity_count": 1,
    "responsibilities": [
      "combined_scribe_lens_creative_direction",
      "world_and_city",
      "people_and_simulation",
      "transportation",
      "social_and_lifestyle",
      "systems_and_gameplay",
      "asset_pipeline",
      "integration_preparation"
    ],
    "model_backend": "ollama",
    "primary_model_candidate": "qwen2.5-coder:1.5b",
    "primary_model_verified_on_target_host": false,
    "backup_model_candidates": [],
    "model_selection_rule": "Use only a model tag verified present and inference-tested on the active host; do not assume prior download reports remain current."
  },
  "project_lead_and_qa": {
    "agent_id": "chatgpt-coordinating-conversation",
    "type": "external_chat_project_lead_and_independent_qa",
    "responsibilities": [
      "translate_creator_direction_into_packages",
      "set_priorities_and_dependencies",
      "review_submitted_artifacts",
      "record_defects_and_corrections",
      "verify_resubmissions",
      "maintain_master_project_status",
      "escalate_creator_reserved_decisions"
    ],
    "self_approval_allowed": false
  },
  "memory": {
    "section_count": 9,
    "index_section": "MASTER_PROJECT",
    "retrieval_mode": "selective_on_demand",
    "write_back_required": true,
    "sections": [
      "MASTER_PROJECT",
      "SCRIBE_AND_LENS",
      "WORLD",
      "PEOPLE",
      "TRANSPORTATION",
      "SYSTEMS",
      "QUALITY",
      "ASSET_LIBRARY",
      "SOCIAL_AND_LIFESTYLE"
    ],
    "external_storage": "project_memory_root",
    "backup_required": true
  },
  "production_cycle": {
    "default_build_block_minutes": 30,
    "pipeline": [
      "read_master_project_and_active_batch",
      "selectively_retrieve_relevant_memory",
      "build_package_a_in_30_minute_checkpoint",
      "save_immutable_versioned_checkpoint_and_handoff",
      "start_independent_safe_package_b",
      "chatgpt_reviews_package_a_during_b",
      "route_minor_issues_to_chatgpt_verified_minor_fix_log",
      "route_moderate_issues_to_super_agent_correction_queue",
      "continue_safe_production_while_review_and_corrections_are_managed",
      "pause_new_package_starts_for_major_group_review_when_triggered",
      "version_corrections_and_retest",
      "update_memory_quality_and_master_project_queues",
      "check_batch_exit_gate"
    ],
    "correction_block_minutes": {
      "minimum": 15,
      "default": 30
    },
    "allow_incomplete_checkpoint": true,
    "require_versioned_handoffs": true,
    "prevent_edits_to_submitted_version_during_qa": true,
    "downstream_may_use_unapproved_output_as_final": false,
    "review_policy": "continuous_production_with_risk_based_corrections",
    "chatgpt_minor_fix_allowed": true,
    "minor_fix_constraints": [
      "isolated",
      "unambiguous",
      "low_risk",
      "necessary_file_access_available",
      "does_not_require_super_agent_specialist_tools_or_environment",
      "record_before_after_and_verify"
    ],
    "moderate_correction_owner": "super_agent_correction_queue_after_current_safe_package",
    "major_issue_action": "pause_starting_new_packages_and_hold_creator_chatgpt_super_agent_group_review",
    "major_issue_triggers": [
      "core_direction_or_architecture_wrong",
      "critical_dependency_broken",
      "same_major_defect_recurs_after_correction",
      "multiple_domains_affected",
      "safety_security_or_data_loss_risk",
      "three_or_more_related_moderate_or_high_severity_defects_in_one_package"
    ],
    "creator_review_feedback_enabled": true,
    "correction_policy": "continuous_production_with_risk_based_corrections"
  },
  "resource_policy": {
    "max_concurrent_local_model_calls": 1,
    "cloud_default": false,
    "paid_fallback": false,
    "hosted_provider_requires_verified_zero_cost_quota_and_approved_data_terms": true
  },
  "runtime": {
    "scheduler_enabled": false,
    "activation_requirements": [
      "single_super_agent_runtime_configuration_supported",
      "selective_memory_retrieval_and_writeback_tested",
      "immutable_package_checkpoint_and_manifest_validation_tested",
      "continuous_two_package_overlap_and_external_qa_handoff_tested",
      "minor_fix_log_and_moderate_correction_queue_tested",
      "major_issue_escalation_tested",
      "model_tag_verified_on_target_host",
      "bounded_inference_passed",
      "persistent_package_and_version_records_verified",
      "all_required_tests_passed"
    ]
  },
  "canonical_documents": [
    "agents/SUPER_AGENT_STARTUP_GUIDE.md",
    "agents/SUPER_AGENT_CHARTER.md",
    "agents/SUPER_AGENT_SYSTEM_PROMPT.md",
    "agents/SUPER_AGENT_MEMORY_ARCHITECTURE.md",
    "agents/SUPER_AGENT_PRODUCTION_CYCLE.md",
    "agents/SUPER_AGENT_BATCH_ROADMAP.md",
    "agents/schemas/super-agent-package-manifest.schema.json"
  ],
